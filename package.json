{
  "name": "dsh-startup-secret",
  "version": "1.5.2",
  "description": "DSH 启动界面与启动动画（二次创作版）：长征机主题开机动画，徽章标识 + 赛博电子风人物立绘（可切换）+ 访问密码功能 + 动画结束后的事件窗口。中文主字 + 英文等宽副标题，真声素材 + 界面音效，身份名称等参数在 DSH 设置页可改。web profile 与 desktop profile 通用。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "startup",
    "splash",
    "boot-animation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "preview/index.html",
    "open-preview.sh",
    "打开预览.cmd",
    "安装.cmd",
    "install.sh",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "DESKTOP.md",
    "AUDIO-FIELDS.md",
    "LICENSE",
    "RELEASE-NOTES-1.5.2.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "二次创作作者",
  "scripts": {
    "test": "node test/smoke-host.mjs && node test/smoke-splash.mjs && node test/smoke-client.mjs && node test/smoke-desktop-boot.mjs && node test/new-options.mjs"
  }
}
